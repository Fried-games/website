---
import Layout from '../layouts/Layout.astro';

const games = [
  {
    title: "Stroom",
    description: "A unique experience from FriedGames. More details coming soon.",
    status: "Coming 2026",
    platforms: ["PC"],
    steamUrl: "https://store.steampowered.com/app/3869320/Stroom/",
  },
];
---

<Layout title="Games" description="All games made by FriedGames">
  <h1>Our Games</h1>

  <ul>
    {games.map((game) => (
      <li>
        <h2>{game.title}</h2>
        <p>{game.description}</p>
        <p>Status: {game.status}</p>
        <p>Platforms: {game.platforms.join(", ")}</p>
        <a href={game.steamUrl} target="_blank" rel="noopener noreferrer">Wishlist on Steam</a>
      </li>
    ))}
  </ul>
</Layout>
