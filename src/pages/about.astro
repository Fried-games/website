---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About Fried Games studio">
  <div class="page">
    <section class="page-header">
      <h1>About</h1>
    </section>

    <section class="content-section">
      <h2>Who we are</h2>
      <p>Fried Games is an independent game studio founded with a passion for cooking games.</p>
    </section>

    <section class="content-section">
      <h2>What we do</h2>
      <p>We design, develop and publish our own games on PC via Steam.</p>
    </section>

    <section class="content-section">
      <h2>Get in touch</h2>
      <a href="/contact">Contact us →</a>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--fg-border);
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .content-section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--fg-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 680px;
  }

  .content-section:last-child {
    border-bottom: none;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-gray);
  }

  p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg-white);
  }

  a {
    font-weight: 700;
    font-size: 1rem;
    align-self: flex-start;
    border-bottom: 2px solid var(--fg-white);
    padding-bottom: 2px;
  }
</style>
