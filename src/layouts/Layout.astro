          </div>
          <div class="footer-emails">
            <a href="mailto:contact@friedgames.com">contact@friedgames.com</a>
            <a href="mailto:press@friedgames.com">press@friedgames.com</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --stroom-main: #FFD500;
    --stroom-dark: #FDAB00;
    --fg-black: #000000;
    --fg-white: #ffffff;
    --fg-gray: #aaaaaa;
    --fg-border: rgba(255, 255, 255, 0.12);
  }

  html {
    font-family: 'Poppins', sans-serif;
    color: var(--fg-white);
    background: var(--fg-black);
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Header */
  header {
    position: sticky;
    top: 0;
    background: var(--fg-black);
    z-index: 10;
  }

  header nav {
    width: 100%;
    padding: 0 3rem;
    height: 80px;
    display: flex;
    align-items: center;
    position: relative;
  }

  header nav .logo {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  header nav .logo img {
    display: block;
    height: 48px;
    width: auto;
  }

  header nav .logo span {
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--fg-white);
  }

  header nav ul {
    list-style: none;
    display: flex;
    gap: 2.5rem;
    position: absolute;
    left: 0;
    right: 0;
    justify-content: center;
    pointer-events: none;
  }

  header nav ul li {
    pointer-events: all;
  }

  header nav ul a {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.75);
    display: inline-block;
    transition: color 0.15s, transform 0.15s;
  }

  header nav ul a:hover {
    color: var(--fg-white);
    transform: translateY(-2px);
  }

  /* Footer */
  footer {
    background: #000000;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  footer .footer-left img {
    display: block;
    height: 72px;
    width: auto;
  }

  footer p {
    font-size: 0.85rem;
    color: #666;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .footer-socials {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .footer-socials a {
    color: #666;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .footer-socials a:hover {
    color: #fff;
  }

  .footer-socials svg {
    width: 20px;
    height: 20px;
  }

  .footer-emails {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: right;
  }

  .footer-emails a {
    font-size: 0.85rem;
    color: #666;
    transition: color 0.15s;
  }

  .footer-emails a:hover {
    color: #fff;
  }

  /* Page content */
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 3rem;
  }
</style>
